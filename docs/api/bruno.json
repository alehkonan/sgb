{
  "version": "1",
  "name": "api",
  "type": "collection",
  "ignore": [
    "node_modules",
    ".git"
  ],
  "size": 0,
  "filesCount": 0,
  "presets": {
    "requestType": "http",
    "requestUrl": "{{api_url}}"
  },
  "proxy": {
    "inherit": true,
    "config": {
      "protocol": "http",
      "hostname": "",
      "port": "",
      "auth": {
        "username": "",
        "password": ""
      },
      "bypassProxy": ""
    }
  }
}